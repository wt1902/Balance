<?xml version="1.0" encoding="utf-8"?>
<!-- The sample texts show in the widget picker preview; BalanceWidgetProvider
     replaces them with the app's figures. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.8"
            android:text="Баланс"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/widget_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_add_background"
            android:contentDescription="Добавить расход"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_plus" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="128 450,00 ₽"
        android:textColor="@color/widget_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_expenses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Расходы за месяц: 21 300,00 ₽"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_budget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.8"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Остаток бюджета: 8 700,00 ₽ из 30 000,00 ₽"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />
</LinearLayout>
